[Unit]
Description=IoT telemetry gateway (store-and-forward)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/iot-gateway/gateway
ExecStart=/opt/iot-gateway/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
